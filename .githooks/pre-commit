#!/bin/sh
# Control previo al commit (Fase 2): bloquea los archivos de las categorías sensibles de la regla 6 de CLAUDE.md (CV,
# órdenes de servicio, recibos, contactos, puntos focales, credenciales) y los textos con rutas locales del usuario;
# avisa de los archivos de más de 5 MB. Usa src/nucleo/auditoria.py, que solo necesita la biblioteca estándar.
# Se activa una vez por copia del repositorio con:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
for py in "py -3" python3 python; do
  if $py -c "import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)" >/dev/null 2>&1; then
    PYTHONUTF8=1 $py src/nucleo/auditoria.py commit
    exit $?
  fi
done
echo "pre-commit: no se encontró Python 3; no se pudo auditar el commit." >&2
exit 1
